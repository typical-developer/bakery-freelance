+import CreatorVideo from "./CreatorVideo";
+import PhotoCard from "./PhotoCard";
+import { getCreators } from "../media";
+
+/** Content-creator spotlight. Videos come from /public/creators (see
+    app/creators.ts). Until some are added, "coming soon" cards hold the place. */
+export default function CreatorSpotlight() {
+  const creators = getCreators();
+  return (
+    <section className="section section--torn section--mint" id="creators">
+      <div className="container">
+        <div className="section-head">
+          <span className="eyebrow" data-fade>
+            Creator spotlight
+          </span>
+          <h2 className="display-2" data-split>
+            the creators craving la crave
+          </h2>
+          <p className="lead" data-fade>
+            Content creators share their favourite La Crave moments. Press play,
+            then place an order of your own.
+          </p>
+        </div>
+        <div className="section-gap" />
+        <div className="creator-row">
+          {creators.map((creator, index) => (
+            <PhotoCard
+              key={creator.id}
+              flip={index % 2 === 1}
+              media={
+                creator.video ? (
+                  <CreatorVideo src={creator.video} poster={creator.poster} label={creator.name} />
+                ) : (
+                  <div className="creator-soon">
+                    <span className="creator-play" aria-hidden="true">
+                      <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
+                        <path d="M8 5v14l11-7z" />
+                      </svg>
+                    </span>
+                    <span>Video coming soon</span>
+                  </div>
+                )
+              }
+            >
+              {creator.video ? (
+                <div className="photo-card-body">
+                  <div className="photo-card-row">
+                    <h3 className="title-3">{creator.name}</h3>
+                    {creator.handle ? (
+                      creator.href ? (
+                        <a href={creator.href} target="_blank" rel="noreferrer" className="creator-handle">
+                          {creator.handle}
+                        </a>
+                      ) : (
+                        <span className="creator-handle">{creator.handle}</span>
+                      )
+                    ) : null}
+                  </div>
+                  {creator.quote ? <p className="small">{creator.quote}</p> : null}
+                </div>
+              ) : null}
+            </PhotoCard>
+          ))}
+        </div>
+      </div>
+    </section>
+  );
+}
diff --git a/app/components/CreatorVideo.tsx b/app/components/CreatorVideo.tsx
new file mode 100644
index 0000000..7406112
--- /dev/null
+++ b/app/components/CreatorVideo.tsx
@@ -0,0 +1,124 @@
+"use client";
+
+import { useEffect, useRef, useState } from "react";
+
+const SOUND_EVENT = "lc-creator-sound";
+
+function Icon({ path }: { path: string }) {
+  return (
+    <svg
+      width="20"
+      height="20"
+      viewBox="0 0 24 24"
+      fill="none"
+      stroke="currentColor"
+      strokeWidth="2"
+      strokeLinecap="round"
+      strokeLinejoin="round"
+      aria-hidden="true"
+    >
+      <path d={path} />
+    </svg>
+  );
+}
+
+/** A creator's video. It plays quietly on a loop while it is on screen; the
+    speaker button turns the sound on (and silences any other video), and
+    tapping the picture pauses it. Nothing autoplays for reduced motion. */
+export default function CreatorVideo({ src, poster, label }: { src: string; poster?: string; label: string }) {
+  const video = useRef<HTMLVideoElement>(null);
+  const [muted, setMuted] = useState(true);
+  const [playing, setPlaying] = useState(false);
+
+  useEffect(() => {
+    const element = video.current;
+    if (!element) return;
+    const calm = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
+    const observer = new IntersectionObserver(
+      ([entry]) => {
+        if (entry.isIntersecting) {
+          if (!calm) element.play().catch(() => {});
+        } else {
+          element.pause();
+        }
+      },
+      { threshold: 0.5 },
+    );
+    observer.observe(element);
+
+    /* Another video turned its sound on: this one goes quiet. */
+    const onSound = (event: Event) => {
+      if ((event as CustomEvent<HTMLVideoElement>).detail !== element) {
+        element.muted = true;
+        setMuted(true);
+      }
+    };
+    window.addEventListener(SOUND_EVENT, onSound);
+    return () => {
+      observer.disconnect();
+      window.removeEventListener(SOUND_EVENT, onSound);
+    };
+  }, []);
+
+  const toggleSound = () => {
+    const element = video.current;
+    if (!element) return;
+    const next = !element.muted;
+    element.muted = next;
+    setMuted(next);
+    if (!next) {
+      window.dispatchEvent(new CustomEvent(SOUND_EVENT, { detail: element }));
+      element.play().catch(() => {});
+    }
+  };
+
+  const togglePlay = () => {
+    const element = video.current;
+    if (!element) return;
+    if (element.paused) element.play().catch(() => {});
+    else element.pause();
+  };
+
+  return (
+    <>
+      <video
+        ref={video}
+        className="creator-video"
+        src={src}
+        poster={poster}
+        muted
+        loop
+        playsInline
+        preload="metadata"
+        onPlay={() => setPlaying(true)}
+        onPause={() => setPlaying(false)}
+        aria-label={`Video from ${label}`}
+      />
+      <button
+        type="button"
+        className="creator-surface"
+        onClick={togglePlay}
+        aria-label={playing ? `Pause video from ${label}` : `Play video from ${label}`}
+      >
+        {playing ? null : (
+          <span className="creator-play">
+            <Icon path="M8 5v14l11-7z" />
+          </span>
+        )}
+      </button>
+      <button
+        type="button"
+        className="creator-sound"
+        onClick={toggleSound}
+        aria-label={muted ? "Turn sound on" : "Turn sound off"}
+        aria-pressed={!muted}
+      >
+        {muted ? (
+          <Icon path="M11 5 6 9H2v6h4l5 4V5zM22 9l-6 6M16 9l6 6" />
+        ) : (
+          <Icon path="M11 5 6 9H2v6h4l5 4V5zM15.5 8.5a5 5 0 0 1 0 7M19 5a10 10 0 0 1 0 14" />
+        )}
+      </button>
+    </>
+  );
+}
