+/* ---------- creator spotlight ---------- */
+.creator-row {
+  display: grid;
+  grid-template-columns: repeat(auto-fit, minmax(14.5rem, 18rem));
+  justify-content: center;
+  gap: clamp(2rem, 4vw, 3rem);
+}
+.creator-card .photo-card-media {
+  aspect-ratio: 9 / 16;
+}
+.creator-video {
+  position: absolute;
+  inset: 0;
+  width: 100%;
+  height: 100%;
+  object-fit: cover;
+  background: #2c2c2d;
+}
+.creator-surface {
+  position: absolute;
+  inset: 0;
+  display: grid;
+  place-items: center;
+  width: 100%;
+  border-radius: 0;
+}
+.creator-play {
+  display: grid;
+  place-items: center;
+  width: 3.5rem;
+  height: 3.5rem;
+  border: 1.5px solid var(--ink);
+  border-radius: 50%;
+  background: var(--brand);
+  color: var(--on-brand);
+  box-shadow: 0 3px 0 var(--ink);
+}
+.creator-play svg {
+  margin-left: 2px;
+}
+.creator-sound {
+  position: absolute;
+  z-index: 2;
+  right: 0.75rem;
+  bottom: 0.75rem;
+  display: grid;
+  place-items: center;
+  width: 2.75rem;
+  height: 2.75rem;
+  border: 1.5px solid var(--ink);
+  border-radius: 50%;
+  background: var(--white);
+  transition:
+    background-color 0.2s,
+    translate 0.25s var(--ease-out);
+}
+.creator-sound:hover {
+  background: var(--yellow);
+}
+.creator-sound:active {
+  translate: 0 2px;
+}
+.creator-soon {
+  position: absolute;
+  inset: 0;
+  display: grid;
+  place-content: center;
+  justify-items: center;
+  gap: 0.875rem;
+  background: repeating-linear-gradient(135deg, #f6e8d6 0 0.875rem, #f1e3d0 0.875rem 1.75rem);
+  font-size: 0.9375rem;
+  font-weight: 600;
+  color: var(--ink-2);
+}
+.creator-handle {
+  font-size: 0.9375rem;
+  font-weight: 600;
+  color: var(--ink-2);
+  text-decoration: underline;
+  text-decoration-thickness: 1.5px;
+  text-underline-offset: 0.3em;
+  text-decoration-color: rgb(44 44 45 / 0.4);
+  transition: text-decoration-color 0.25s;
+}
+a.creator-handle:hover {
+  text-decoration-color: var(--pink);
+}
+
 /* ---------- cta ---------- */
