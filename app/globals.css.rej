+/* Torn paper. The sheet is an SVG background; the grain sits in a pseudo-element
+   masked by that same SVG, so it only lands on the paper. (Painted over the whole
+   box it also covered the strip past the torn edge, which then stopped at the
+   section's edge as a hard horizontal line.) */
+.section--torn,
+.section--hero,
+.section--footer {
+  position: relative;
+  background-image: var(--torn);
+  background-position: var(--torn-pos, 50%);
   background-repeat: no-repeat;
   background-size: cover;
 }
+.section--torn::before,
+.section--hero::before,
+.section--footer::before {
+  content: "";
+  position: absolute;
+  inset: 0;
+  pointer-events: none;
+  background: url("/backgrounds/grain.svg") 0 0 / 15rem 15rem;
+  -webkit-mask: var(--torn) var(--torn-pos, 50%) / cover no-repeat;
+  mask: var(--torn) var(--torn-pos, 50%) / cover no-repeat;
+}
+.section--torn {
+  padding-block: var(--torn-y);
+}
